    "muted-foreground": "#5A6475",
    "accent": "#F1F5F9",
    "accent-foreground": "#0F172B",
    "destructive": "#E7000B",
    "destructive-foreground": "#F8FAFC",
    "border": "#DCE2E9",
    "border-subtle": "#E8EBF1",
    "input": "#DCE2E9",
    "ring": "#90A1B9",
    "success": "#0FA44D",
    "success-soft": "#E0FAE4",
    "warning": "#E48300",
    "warning-soft": "#FFF2D4",
    "danger": "#E7000B",
    "danger-soft": "#FFE9E6",
    "danger-foreground": "#FFFFFF",
    "info": "#0086CF",
    "info-soft": "#E4F7FF",
    "surface-subtle": "#F5F7F9",
    "surface-raised": "#FFFFFF",
    "overlay": "#03060D",
