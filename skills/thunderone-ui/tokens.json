    "chart-2": "#009689",
    "chart-3": "#104E64",
    "chart-4": "#FFB900",
    "chart-5": "#FE9A00",
    "sidebar": "#FFFFFF",
    "sidebar-foreground": "#020618",
    "sidebar-primary": "#0F172B",
    "sidebar-primary-foreground": "#F8FAFC",
    "sidebar-accent": "#F1F5F9",
    "sidebar-accent-foreground": "#0F172B",
    "sidebar-border": "#E2E8F0",
    "sidebar-ring": "#90A1B9"
  },
  "status": {
    "$note": "Five semantic tones. Each Workspace maps its own states onto these in references/workspaces/<workspace>.md. Never invent new status colors, never use them for taxonomy.",
    "success": { "fg": "success", "bg": "success-soft" },
    "warning": { "fg": "warning", "bg": "warning-soft" },
    "danger": { "fg": "danger", "bg": "danger-soft" },
    "info": { "fg": "info", "bg": "info-soft" },
    "neutral": { "fg": "muted-foreground", "bg": "muted" }
  },
  "status-map": {
    "$note": "Default state → tone map of the StatusBadge in design-system/core.tsx. Unknown states fall back to neutral. A Workspace profile may add states; it never moves one listed here.",
    "success": ["active", "online", "ready", "published", "completed"],
    "warning": ["warning", "pending"],
    "danger": ["error", "failed", "offline", "blocked"],
    "info": ["scheduled", "draft", "processing", "in-progress", "uploading"],
    "neutral": ["inactive", "archived", "unknown"]
  },
  "font": {
    "family": {
      "sans": "'Manrope', 'Anuphan', system-ui, sans-serif",
      "$note": "Manrope has no Thai glyphs, so Thai characters fall through to Anuphan, the official Thai pair (decided 2026-11-22)."
    },
    "google-fonts": "https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "text": {
    "$note": "Figma text styles. size/lineHeight/weight are English (Manrope). lineHeightTh is the Thai/... style (Anuphan): taller for vowels and tone marks. Anuphan has no ExtraBold, so weightTh is 700 there. Thai never uses uppercase or tracking.",
    "display-kpi": { "figma": "Display/KPI value", "size": "24px", "lineHeight": "32px", "weight": 700, "lineHeightTh": "36px" },
    "title-page": { "figma": "Title/Page", "size": "20px", "lineHeight": "28px", "weight": 800, "letterSpacing": "-0.025em", "lineHeightTh": "32px", "weightTh": 700 },
    "heading-large": { "figma": "Heading/Large", "size": "18px", "lineHeight": "28px", "weight": 700, "lineHeightTh": "32px" },
    "heading-dialog": { "figma": "Heading/Dialog", "size": "18px", "lineHeight": "18px", "weight": 600, "lineHeightTh": "28px" },
    "heading-section": { "figma": "Heading/Section", "size": "16px", "lineHeight": "24px", "weight": 700, "lineHeightTh": "28px" },
    "title-card": { "figma": "Title/Card", "size": "14px", "lineHeight": "20px", "weight": 700, "lineHeightTh": "24px" },
    "body": { "figma": "Body/Default", "size": "14px", "lineHeight": "20px", "weight": 400, "lineHeightTh": "24px" },
    "body-sm": { "figma": "Body/Small", "size": "12px", "lineHeight": "16px", "weight": 400, "lineHeightTh": "20px" },
    "label-sm": { "figma": "UI/Label sm Semibold (Medium)", "size": "14px", "lineHeight": "20px", "weight": 600, "lineHeightTh": "24px" },
    "label-xs": { "figma": "UI/Label xs Semibold (Medium)", "size": "12px", "lineHeight": "16px", "weight": 600, "lineHeightTh": "20px" },
    "ui": { "figma": "UI/Default", "size": "11px", "lineHeight": "16px", "weight": 400, "lineHeightTh": "20px" },
    "caption-2xs": { "figma": "Caption/2xs", "size": "10px", "lineHeight": "14px", "weight": 400, "lineHeightTh": "18px" },
    "caption-9": { "figma": "Caption/9", "size": "9px", "lineHeight": "13.5px", "weight": 400, "lineHeightTh": "16px" },
    "caption-3xs": { "figma": "Caption/3xs", "size": "8px", "lineHeight": "12px", "weight": 400, "lineHeightTh": "16px" },
    "label-section": { "figma": "Label/Section", "size": "11px", "lineHeight": "16px", "weight": 800, "letterSpacing": "0.08em", "uppercase": true, "lineHeightTh": "20px", "weightTh": 700 },
    "label-type": { "figma": "Label/Type label", "size": "10px", "lineHeight": "14px", "weight": 700, "letterSpacing": "0.08em", "uppercase": true, "lineHeightTh": "18px" }
  },
  "radius": {
    "$note": "--radius base 0.75rem (12px). Tailwind: sm = radius − 4, md = radius − 2, lg = radius, xl = radius + 4.",
    "sm": "8px",
    "md": "10px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "3xl": "24px",
    "4xl": "28px",
    "full": "9999px"
  },
  "shadow": {
    "$note": "Figma effect styles from --shadow-*; colour = foreground #0F1727 (rgb 15 23 39) at 4 / 12 / 18%.",
    "panel": "0 1px 2px 0 rgba(15, 23, 39, 0.04)",
    "float": "0 14px 36px 0 rgba(15, 23, 39, 0.12)",
    "dialog": "0 24px 60px 0 rgba(15, 23, 39, 0.18)"
  },
  "spacing": {
    "$note": "Tailwind 4px scale: calc(var(--spacing) * n). Use the scale, not literal px.",
    "base": "4px",
    "shell-header": "68px",
    "summary-card": "88px"
  },
  "layout": {
    "sidebar": "224px",
    "sidebar-collapsed": "68px",
    "sidebar-drawer": "256px",
    "header": "68px",
    "content-padding-x": "24px",
    "content-padding-x-compact": "16px",
    "content-padding-top": "20px",
    "card-gap": "16px",
    "columns": 12,
    "gutter": "16px",
    "gutter-compact": "12px",
    "kpi-card-min": "300px",
    "text-measure": "720px",
    "search-max": "448px",
    "dialog-max": "512px"
  },
  "breakpoint": {
    "$note": "Tailwind breakpoints in code (xs is custom). Design sizes: 1920×1080 primary, 1440×900 option, 1280×800 minimum that must fully work, 1024 small desktop/tablet, 390 field pages only.",
    "xs": "480px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "z": {
    "nav": 20,
    "sticky": 30,
    "overlay": 60,
    "modal": 70,
    "popover": 80,
    "tooltip": 90
  },
  "motion": {
    "sidebar": "200ms cubic-bezier(0.4, 0, 0.2, 1)",
    "colors": "150ms"
  }
