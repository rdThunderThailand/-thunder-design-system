{
  "name": "thunder-design-system",
  "version": "0.2.0",
  "private": true,
  "description": "ThunderOne design system: agent skill, theme package and setup CLI.",
  "type": "module",
  "bin": {
    "thunderone-setup": "bin/setup.mjs"
  },
  "files": [
    "bin",
    "skills/thunderone-ui/AGENTS.snippet.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:tokens": "node scripts/build.mjs",
    "check:tokens": "node scripts/build.mjs --check",
    "build": "npm run build:tokens && npm run build -w @rdthunderthailand/thunderone-theme",
    "typecheck": "npm run typecheck -w @rdthunderthailand/thunderone-theme",
    "test": "node scripts/test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
