{
  "name": "@rdthunderthailand/thunderone-theme",
  "version": "0.2.0",
  "description": "ThunderOne design tokens and themes for every Workspace: Ant Design, Tailwind v3/v4, shadcn/ui, icons and Workspace extras.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdThunderThailand/-thunder-design-system.git",
    "directory": "packages/thunderone-theme"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tailwind",
    "brand",
    "global.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./antd": {
      "types": "./dist/antd.d.ts",
      "import": "./dist/antd.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./workspaces/media": {
      "types": "./dist/workspaces/media.d.ts",
      "import": "./dist/workspaces/media.js"
    },
    "./global.css": "./global.css",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./tailwind/shadcn.css": "./tailwind/shadcn.css",
    "./tailwind/v4.css": "./tailwind/v4.css",
    "./brand/*": "./brand/*",
    "./package.json": "./package.json",
    "./tailwind/preset.cjs": "./tailwind/preset.cjs"
  },
  "scripts": {
    "build": "rm -rf dist tailwind brand global.css && tsc -p tsconfig.json && mkdir -p tailwind brand && cp src/global.css global.css && cp src/tailwind/* tailwind/ && cp ../../skills/thunderone-ui/assets/brand/*.svg brand/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5",
    "antd": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "5.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "antd": "5.29.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.6.0"
  }
}
