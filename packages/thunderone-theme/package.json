{
  "name": "@rdthunderthailand/thunderone-theme",
  "version": "1.0.0",
  "description": "ThunderOne design tokens and theme for every Workspace: Tailwind v4/v3 + shadcn/ui theme, lucide icon map, status tones and Workspace extras.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdThunderThailand/-thunder-design-system.git",
    "directory": "packages/thunderone-theme"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tailwind",
    "brand"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./workspaces/media": {
      "types": "./dist/workspaces/media.d.ts",
      "import": "./dist/workspaces/media.js"
    },
    "./workspaces/asset": {
      "types": "./dist/workspaces/asset.d.ts",
      "import": "./dist/workspaces/asset.js"
    },
    "./tailwind/v4.css": "./tailwind/v4.css",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./tailwind/preset.cjs": "./tailwind/preset.cjs",
    "./tailwind/shadcn.css": "./tailwind/shadcn.css",
    "./brand/*": "./brand/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist tailwind brand && tsc -p tsconfig.json && mkdir -p tailwind brand && cp src/tailwind/* tailwind/ && cp ../../skills/thunderone-ui/assets/brand/*.svg brand/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=0.575.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "lucide-react": "0.575.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.6.0"
  }
}
